# =============================================================================
# Redtail Market — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template and must never contain real values.
#
# !! SECURITY: do NOT add a VITE_ prefix to any secret below. !!
# vite.config.ts (@lovable.dev/vite-tanstack-config) injects every VITE_* var
# into the CLIENT bundle, so a VITE_SQUARE_ACCESS_TOKEN would be published to
# every visitor's browser. These are read server-side only, inside
# createServerFn handlers.
# =============================================================================

# -----------------------------------------------------------------------------
# Square — required
# -----------------------------------------------------------------------------

# Access token for your Square application.
# Dashboard → Developer → Applications → <your app> → Credentials
# Sandbox and Production have SEPARATE tokens — they are not interchangeable.
# Required scopes: ITEMS_READ, INVENTORY_READ, ORDERS_WRITE, PAYMENTS_WRITE
SQUARE_ACCESS_TOKEN=

# Which Square API host to talk to: "sandbox" or "production".
# Must match the token above.
SQUARE_ENVIRONMENT=sandbox

# The location whose catalog, inventory and orders this site reads and writes.
# Dashboard → Developer → Applications → <your app> → Locations
SQUARE_LOCATION_ID=

# -----------------------------------------------------------------------------
# Square — optional (leave blank until the matching feature is built)
# -----------------------------------------------------------------------------

# Only needed if we later embed Square's Web Payments SDK for on-site card
# fields. The current plan uses Square-hosted checkout links, which don't need
# it. Safe to leave blank.
SQUARE_APPLICATION_ID=

# Verifies inbound Square webhooks (e.g. catalog.version.updated) so we can
# invalidate the catalog cache on change instead of polling.
# Dashboard → Developer → Applications → <your app> → Webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Public base URL, used to build the Square checkout redirect back to this site
# (→ /checkout/success). No trailing slash.
# Local dev: http://localhost:8080 (port is set by the Lovable vite config).
SITE_URL=http://localhost:8080
